#!/usr/bin/env sh
# dataeng-cli 启动脚本（Unix / Git Bash / WSL）
# 用法: bin/dataeng-cli --help
set -e

DIR="$(cd "$(dirname "$0")/.." && pwd)"
JAR="$DIR/target/dataeng-cli.jar"

# Git Bash / MSYS 下把 POSIX 路径转成 Windows 路径，供原生 java.exe 使用
if command -v cygpath >/dev/null 2>&1; then
  JAR="$(cygpath -w "$JAR")"
fi

if [ ! -f "$JAR" ]; then
  echo "dataeng-cli: 未找到可执行包 $JAR" >&2
  echo "请先构建:  mvn -q package   (或 make build)" >&2
  exit 1
fi

if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA_BIN="$JAVA_HOME/bin/java"
else
  JAVA_BIN="java"
fi

exec "$JAVA_BIN" -Dfile.encoding=UTF-8 -jar "$JAR" "$@"
